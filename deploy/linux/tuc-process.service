[Unit]
Description=TUC process run (triggered by tuc-process.timer)
After=network-online.target mysql.service
Requires=mysql.service

[Service]
Type=oneshot
User=tuc
Group=tuc
WorkingDirectory=/opt/tuc
ExecStart=/opt/tuc/.venv/bin/python -m app.cli process --trigger cli
# Exit code 75 = another job holds the lock; not a failure.
SuccessExitStatus=75
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tuc/storage /opt/tuc/logs
