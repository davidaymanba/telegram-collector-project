# ─────────────────────────────────────────────────────────────────────────────
# TUC configuration. Copy to .env and edit:   cp .env.example .env && chmod 600 .env
# Relative paths are resolved against the project folder.
# ─────────────────────────────────────────────────────────────────────────────

# --- App ---------------------------------------------------------------------
TUC_APP_ENV=development            # development | production
TUC_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
TUC_LOG_FORMAT=auto                # auto (json in production) | json | console
TUC_LOG_DIR=logs

# --- MySQL 8 (Homebrew) ------------------------------------------------------
# User/password must match scripts/setup_mysql.sql
TUC_DATABASE_URL=mysql+pymysql://tuc:change_me_tuc_password@127.0.0.1:3306/tuc?charset=utf8mb4
# Tests refuse to run unless the database name ends with _test
TUC_TEST_DATABASE_URL=mysql+pymysql://tuc:change_me_tuc_password@127.0.0.1:3306/tuc_test?charset=utf8mb4

# --- Telegram (https://my.telegram.org → API development tools) --------------
TUC_TELEGRAM_API_ID=
TUC_TELEGRAM_API_HASH=
TUC_TELEGRAM_SESSION_PATH=storage/telegram/tuc
TUC_TELEGRAM_REQUEST_DELAY_SECONDS=1.0
TUC_TELEGRAM_COLLECT_TEXT_MESSAGES=false
# false = documents only (PDF/Word/PowerPoint); Telegram filters server-side, much faster in chat groups
TUC_TELEGRAM_COLLECT_PHOTOS=true

# --- Seed files (the database is the source of truth after import) ------------
TUC_CHANNELS_CONFIG_PATH=config/channels.yaml
TUC_SUBJECTS_CONFIG_PATH=config/subjects.yaml

# --- Storage -----------------------------------------------------------------
TUC_STORAGE_ROOT=storage
TUC_INCOMING_STORAGE_DIR=storage/incoming
TUC_PROCESSED_STORAGE_DIR=storage/processed
TUC_UNCLASSIFIED_STORAGE_DIR=storage/unclassified
TUC_TEXTS_STORAGE_DIR=storage/texts
TUC_LOCK_FILE_PATH=storage/collector.lock

# --- OCR (brew install tesseract tesseract-lang) -----------------------------
TUC_OCR_ENABLED=true
TUC_OCR_LANGUAGE=ara+eng
TUC_OCR_MAX_PAGES=15
# Leave empty to auto-detect: PATH → /opt/homebrew/bin → /usr/local/bin
TUC_TESSERACT_CMD=
TUC_MIN_PDF_TEXT_CHARS=200

# --- Classification ----------------------------------------------------------
# Rules always run first. "openai" is only consulted for files the rules can't settle.
TUC_AI_PROVIDER=none               # none | openai
TUC_OPENAI_API_KEY=
TUC_OPENAI_MODEL=gpt-4.1-mini
TUC_MAX_CLASSIFICATION_CHARS=6000
TUC_CLASSIFICATION_MIN_CONFIDENCE=0.7
TUC_CLASSIFICATION_MIN_EVIDENCE_ITEMS=1

# --- Scheduling (launchd StartInterval) ----------------------------------------
TUC_COLLECT_INTERVAL_MINUTES=30
TUC_PROCESS_INTERVAL_MINUTES=15

# --- Dashboard ---------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TUC_SESSION_SECRET=
DASHBOARD_USERNAME=admin
# Prefer an argon2 hash: uv run python -m app.cli hash-password
# (a plain password also works; it is hashed in memory and never stored)
DASHBOARD_PASSWORD=
